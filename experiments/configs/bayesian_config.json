{
  "seed": 42,
  "n_splits": 5,
  "n_initial_random_trials": 8,
  "n_total_trials": 20,
  "acquisition_samples": 20000,
  "objective": "group_cv_macro_f1",
  "selected_model": "hist_gradient_boosting",
  "search_space": {
    "learning_rate": {"type": "log_uniform", "bounds": [0.01, 0.5]},
    "max_leaf_nodes": {"type": "integer", "bounds": [15, 127]},
    "min_samples_leaf": {"type": "integer", "bounds": [5, 150]},
    "l2_regularization": {"type": "log_uniform", "bounds": [0.001, 50.0]},
    "max_iter": {"type": "integer", "bounds": [50, 400]},
    "early_stopping": {"type": "categorical", "choices": [false, true]}
  },
  "default_params": {
    "learning_rate": 0.1,
    "max_leaf_nodes": 31,
    "min_samples_leaf": 20,
    "l2_regularization": 1.0,
    "max_iter": 120,
    "early_stopping": false
  }
}
